{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    { "source": "/", "destination": "/midterm-ledger/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/midterm-ledger/data.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
